generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
}

enum RateType {
  BUY
  SELL
}

enum SourceType {
  EXCHANGE_OFFICE
  NEWS_AGENCY
  CENTRAL_BANK
  OTHER
}

enum Importance {
  LOW
  MEDIUM
  HIGH
}

enum WhatsAppIntegrationStatus {
  DISCONNECTED
  CONNECTED
  FAILED
  WAITING
}

enum WhatsAppSourceType {
  EXCHANGE_RATES
  NEWS
  GOLD_PRICES
  ECONOMIC_EVENTS
}

enum WhatsAppMessageType {
  TEXT
  IMAGE
  DOCUMENT
  AUDIO
  UNKNOWN
}

enum WhatsAppParseStatus {
  PENDING
  PARSED
  FAILED
  REVIEW
  APPROVED
  REJECTED
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  passwordHash String
  role         Role     @default(USER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  whatsapp     WhatsAppIntegration[]
}

model Currency {
  id         String           @id @default(cuid())
  code       String           @unique
  name       String
  symbol     String
  country    String
  flag       String
  isActive   Boolean          @default(true)
  rates      ExchangeRate[]
  historical HistoricalRate[]
  news       News[]
  events     EconomicEvent[]
  forecasts  ForecastSnapshot[]
}

model Source {
  id              String           @id @default(cuid())
  name            String
  website         String
  type            SourceType
  exchangeRates   ExchangeRate[]
  historicalRates HistoricalRate[]
  news            News[]
}

model ExchangeRate {
  id           String    @id @default(cuid())
  currencyCode String
  rate         Decimal
  type         RateType
  sourceId     String
  createdAt    DateTime  @default(now())

  currency Currency @relation(fields: [currencyCode], references: [code])
  source   Source   @relation(fields: [sourceId], references: [id])

  @@index([currencyCode, createdAt])
}

model HistoricalRate {
  id           String    @id @default(cuid())
  currencyCode String
  buyRate      Decimal
  sellRate     Decimal
  sourceId     String
  recordedAt   DateTime  @default(now())

  currency Currency @relation(fields: [currencyCode], references: [code])
  source   Source   @relation(fields: [sourceId], references: [id])

  @@index([currencyCode, recordedAt])
}

model News {
  id           String     @id @default(cuid())
  title        String
  content      String
  category     String
  countryCode  String
  currencyCode String
  importance   Importance
  sourceId     String
  publishedAt  DateTime   @default(now())

  currency Currency @relation(fields: [currencyCode], references: [code])
  source   Source   @relation(fields: [sourceId], references: [id])

  @@index([currencyCode, publishedAt])
}

model EconomicEvent {
  id           String     @id @default(cuid())
  title        String
  country      String
  currencyCode String
  forecast     String
  previous     String
  actual       String?
  importance   Importance
  eventDate    DateTime

  currency Currency @relation(fields: [currencyCode], references: [code])

  @@index([currencyCode, eventDate])
}

model ExchangeOffice {
  id        String  @id @default(cuid())
  name      String
  city      String
  address   String
  phone     String
  latitude  Float
  longitude Float
  verified  Boolean @default(false)
}

model WhatsAppIntegration {
  id                   String                    @id @default(cuid())
  userId               String
  name                 String
  businessAccountId    String
  phoneNumberId        String
  encryptedAccessToken String
  verifyToken          String
  status               WhatsAppIntegrationStatus @default(DISCONNECTED)
  lastSync             DateTime?
  createdAt            DateTime                  @default(now())
  updatedAt            DateTime                  @updatedAt

  user     User               @relation(fields: [userId], references: [id])
  sources  WhatsAppSource[]
  messages WhatsAppMessage[]

  @@map("whatsapp_integrations")
}

model WhatsAppSource {
  id            String             @id @default(cuid())
  integrationId String
  name          String
  description   String?
  type          WhatsAppSourceType
  active        Boolean            @default(true)
  priority      Int                @default(5)
  createdAt     DateTime           @default(now())

  integration WhatsAppIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  messages    WhatsAppMessage[]

  @@map("whatsapp_sources")
}

model WhatsAppMessage {
  id            String               @id @default(cuid())
  integrationId String
  sourceId      String?
  sender        String
  messageId     String
  messageText   String
  messageType   WhatsAppMessageType  @default(TEXT)
  receivedAt    DateTime
  processed     Boolean              @default(false)
  parseStatus   WhatsAppParseStatus  @default(PENDING)
  confidence    Float                @default(0)
  rawPayload    Json
  createdAt     DateTime             @default(now())

  integration WhatsAppIntegration @relation(fields: [integrationId], references: [id], onDelete: Cascade)
  source      WhatsAppSource?     @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  logs        ProcessingLog[]

  @@unique([integrationId, messageId])
  @@index([receivedAt])
  @@map("whatsapp_messages")
}

model ProcessingLog {
  id            String   @id @default(cuid())
  messageId     String
  action        String
  status        String
  errorMessage  String?
  executionTime Int?
  createdAt     DateTime @default(now())

  message WhatsAppMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@index([messageId, createdAt])
  @@map("processing_logs")
}

model DataImport {
  id              String   @id @default(cuid())
  fileName        String
  fileType        String
  datasetType     String
  status          String
  recordsImported Int      @default(0)
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ForecastSnapshot {
  id              String   @id @default(cuid())
  currencyCode    String
  horizonHours    Int
  currentRate     Decimal
  predictedRate   Decimal
  lowerBound      Decimal
  upperBound      Decimal
  confidenceLabel String
  modelVersion    String
  featureCount    Int
  dataPoints      Int
  generatedAt     DateTime @default(now())
  metadata        Json?

  currency Currency @relation(fields: [currencyCode], references: [code])

  @@index([currencyCode, horizonHours, generatedAt])
}
